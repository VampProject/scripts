local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local mouse = LocalPlayer:GetMouse()

local triggerEnabled = false
local espEnabled = false
local teamCache = {}
local losCache = {}
local firing = false
local espObjects = {}

local RED = Color3.fromRGB(255, 0, 0)
local GREEN = Color3.fromRGB(0, 255, 0)

local testSquare = Drawing.new("Square")
testSquare.Visible = true
testSquare.Color = Color3.fromRGB(255, 0, 0)
testSquare.Thickness = 2
testSquare.Filled = false
testSquare.Transparency = 0
testSquare.Size = Vector2.new(40, 40)
testSquare.Position = Vector2.new(20, 20)

local skeletonParts = {
    "Head", "UpperTorso", "LowerTorso",
    "LeftUpperArm", "LeftLowerArm", "LeftHand",
    "RightUpperArm", "RightLowerArm", "RightHand",
    "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
    "RightUpperLeg", "RightLowerLeg", "RightFoot",
    "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg"
}
local connections = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
    {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
    {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
}

task.spawn(function()
    while task.wait(1) do
        for _, plr in Players:GetPlayers() do
            teamCache[plr] = plr.Team
        end
    end
end)

local function isEnemy(plr)
    if not plr or plr == LocalPlayer then return false end
    local myTeam = LocalPlayer.Team
    local theirTeam = teamCache[plr] or plr.Team
    if not myTeam or not theirTeam then return true end
    return myTeam ~= theirTeam
end

local function createSkeleton()
    local skeletonLines = {}
    for i = 1, #connections do
        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = GREEN
        line.Transparency = 1
        skeletonLines[i] = line
    end
    return skeletonLines
end


Players.PlayerRemoving:Connect(function(plr)
    local esp = espObjects[plr]
    if esp then
        for _, line in ipairs(esp) do
            line:Remove()
        end
        espObjects[plr] = nil
    end
    losCache[plr] = nil
end)


UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F then
        triggerEnabled = not triggerEnabled
        print("AeShoot: " .. (triggerEnabled and "Activado" or "Desactivado"))
    elseif input.KeyCode == Enum.KeyCode.Z then
        espEnabled = not espEnabled
        print("ESP Skeleton: " .. (espEnabled and "Activado" or "Desactivado"))
    end
end)

RunService.RenderStepped:Connect(function()
    local localChar = LocalPlayer.Character
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") or not localChar:FindFirstChild("Head") then
        if firing then firing = false; mouse1release() end
        for _, esp in pairs(espObjects) do
            for i = 1, #esp do
                esp[i].Visible = false
            end
        end
        return
    end
    local ourChar = localChar
    local ourHead = localChar.Head
    local ourRoot = localChar.HumanoidRootPart
    local myPos = ourRoot.Position

    -- TRIGGERBOT
    local shouldFire = false
    local target = mouse.Target
    if triggerEnabled and target and target.Parent then
        local char = target.Parent
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local plr = Players:GetPlayerFromCharacter(char)
            if isEnemy(plr) then shouldFire = true end
        end
    end
    if shouldFire ~= firing then
        firing = shouldFire
        if shouldFire then mouse1press() else mouse1release() end
    end

    if not espEnabled then
        for _, esp in pairs(espObjects) do
            for i = 1, #esp do
                esp[i].Visible = false
            end
        end
        return
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then
            local esp = espObjects[player]
            if esp then
                for i = 1, #esp do esp[i].Visible = false end
            end
            continue
        end
        local hum = char.Humanoid
        if hum.Health <= 0 then
            local esp = espObjects[player]
            if esp then
                for i = 1, #esp do esp[i].Visible = false end
            end
            continue
        end
        local root = char.HumanoidRootPart
        local dist = (myPos - root.Position).Magnitude
        if dist > 500 then
            local esp = espObjects[player]
            if esp then
                for i = 1, #esp do esp[i].Visible = false end
            end
            continue
        end

        local now = tick()
        local playerLos = losCache[player]
        local hasLos = false
        local theirHead = char:FindFirstChild("Head")
        if theirHead then
            if not playerLos or now - playerLos.tick > 0.15 then
                local rayOrigin = theirHead.Position
                local targetPos = ourHead.Position
                local rayDirection = (targetPos - rayOrigin).Unit * ((targetPos - rayOrigin).Magnitude + 3)
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Blacklist
                rayParams.FilterDescendantsInstances = {char}
                local result = Workspace:Raycast(rayOrigin, rayDirection, rayParams)
                hasLos = result and result.Instance:IsDescendantOf(ourChar)
                losCache[player] = {los = hasLos, tick = now}
            else
                hasLos = playerLos.los
            end
        end
        local col = hasLos and RED or GREEN
        local partPositions = {}
        for _, partName in ipairs(skeletonParts) do
            local part = char:FindFirstChild(partName)
            if part then
                partPositions[partName] = part.Position
            end
        end

        if not partPositions["Head"] then
            local esp = espObjects[player]
            if esp then
                for i = 1, #esp do esp[i].Visible = false end
            end
            continue
        end

        local headPos = partPositions["Head"]
        local headScreen, headOnScreen = Camera:WorldToViewportPoint(headPos)
        if not headOnScreen or headScreen.Z <= 0 then
            local esp = espObjects[player]
            if esp then
                for i = 1, #esp do esp[i].Visible = false end
            end
            continue
        end


        local esp = espObjects[player]
        if not esp then
            esp = createSkeleton()
            espObjects[player] = esp
        end

        -- Update skeleton lines
        local thickness = math.clamp(2500 / dist, 1, 5)
        for i, conn in ipairs(connections) do
            local p1Pos = partPositions[conn[1]]
            local p2Pos = partPositions[conn[2]]
            local line = esp[i]
            if p1Pos and p2Pos then
                local s1, on1 = Camera:WorldToViewportPoint(p1Pos)
                local s2, on2 = Camera:WorldToViewportPoint(p2Pos)
                if on1 and on2 and s1.Z > 0 and s2.Z > 0 then
                    line.From = Vector2.new(s1.X, s1.Y)
                    line.To = Vector2.new(s2.X, s2.Y)
                    line.Thickness = thickness
                    line.Color = col
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        end
    end
end)

print("AEShoot| F: AeShoot | Z: ESP Skeleton")
