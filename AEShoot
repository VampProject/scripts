-- ===================== CONFIGURACION =====================
local PROBABILIDAD       = 1.00  -- Chance de auto-click al detectar enemigo (1.00 = 100%, 0.70 = 70%)
local RETARDO            = 0.0   -- Segundos de espera mínima entre cada click automático (0 = sin espera)
local PREDICCION         = 0.10  -- Predice la posición futura del enemigo en pantalla según su velocidad
local PREDICCION_DISPARO = 0.145 -- Igual que PREDICCION pero para la dirección del autoshoot
local PODER_KILL         = 5     -- Cuántas veces se envía el remote "kill" por disparo
local DELAY_KILL         = 0.03  -- Segundos entre cada envío del remote "kill"
local ESP_ACTIVADO       = true  -- Mostrar ESP box + skeleton a todos los jugadores cercanos (toggle con Z)
local ESP_DISTANCIA      = 500   -- Distancia máxima en studs para mostrar el ESP
local ESP_COLOR          = Color3.fromRGB(0, 255, 0)
local ESP_GROSOR_BOX     = 1.5   -- Grosor del box
local ESP_GROSOR_SKEL    = 1     -- Grosor del skeleton
-- =========================================================

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LP  = Players.LocalPlayer
local Cam = workspace.CurrentCamera

local activado    = true
local ultimoClick = 0
local espDatos    = {}

local CONEXIONES_ESQUELETO = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"LowerTorso","LeftUpperLeg"},{"LowerTorso","RightUpperLeg"},
    {"LeftUpperLeg","LeftLowerLeg"},{"RightUpperLeg","RightLowerLeg"},
    {"LeftLowerLeg","LeftFoot"},{"RightLowerLeg","RightFoot"},
    {"UpperTorso","LeftUpperArm"},{"UpperTorso","RightUpperArm"},
    {"LeftUpperArm","LeftLowerArm"},{"RightUpperArm","RightLowerArm"},
    {"LeftLowerArm","LeftHand"},{"RightLowerArm","RightHand"},
}

print("[AutoClick] F=autoclick  Z=esp")

local function EsEnemigo(jugador)
    if jugador == LP then return false end
    if not jugador.Character then return false end
    local hum = jugador.Character:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return (jugador:GetAttribute("Team") or "nothing") ~= (LP:GetAttribute("Team") or "nothing")
       and (jugador:GetAttribute("Game") or "nothing") == (LP:GetAttribute("Game") or "nothing")
end

local function tieneLoS(charEnemigo)
    local char = LP.Character
    if not char then return false end
    local miHRP = char:FindFirstChild("HumanoidRootPart")
    if not miHRP then return false end
    local filtro = {char}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then table.insert(filtro, p.Character) end
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filtro
    local eHRP    = charEnemigo:FindFirstChild("HumanoidRootPart")
    local eCabeza = charEnemigo:FindFirstChild("Head")
    if not eHRP then return false end
    local puntos = {eHRP.Position, eHRP.Position + Vector3.new(0,0.5,0), eHRP.Position + Vector3.new(0,-1.5,0)}
    if eCabeza then table.insert(puntos, eCabeza.Position) end
    for _, origen in ipairs({miHRP.Position, Cam.CFrame.Position}) do
        for _, punto in ipairs(puntos) do
            if not workspace:Raycast(origen, punto - origen, params) then return true end
        end
    end
    return false
end

local function obtenerArma()
    local char = LP.Character
    if not char then return nil end
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("fire") and tool:FindFirstChild("showBeam") and tool:FindFirstChild("kill") then
            return tool
        end
    end
end

local function dispararAuto(datos)
    local char = LP.Character
    if not char then return end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    local arma = obtenerArma()
    if not hrp or not arma then return end
    local fireEvent     = arma:FindFirstChild("fire")
    local showBeamEvent = arma:FindFirstChild("showBeam")
    local killEvent     = arma:FindFirstChild("kill")
    local handle        = arma:FindFirstChild("Handle")
    if not (fireEvent and showBeamEvent and killEvent and handle) then return end
    local posObjetivo = datos.hrp.Position + (datos.hrp.AssemblyLinearVelocity * PREDICCION_DISPARO)
    local direccion   = CFrame.lookAt(hrp.Position, posObjetivo).LookVector
    fireEvent:FireServer()
    showBeamEvent:FireServer(posObjetivo, hrp.Position, handle)
    task.spawn(function()
        for i = 1, PODER_KILL do
            killEvent:FireServer(datos.jugador, direccion)
            if i < PODER_KILL then task.wait(DELAY_KILL) end
        end
    end)
end

local function cursorSobreHitbox(charEnemigo, posMouse, eHRP)
    local fov        = math.rad(Cam.FieldOfView)
    local factorProj = Cam.ViewportSize.Y / (2 * math.tan(fov / 2))
    for _, parte in ipairs(charEnemigo:GetDescendants()) do
        if not parte:IsA("BasePart") then continue end
        local posParte       = parte.Position + (eHRP.AssemblyLinearVelocity * PREDICCION)
        local sp, enPantalla = Cam:WorldToScreenPoint(posParte)
        if not enPantalla or sp.Z <= 0 then continue end
        local distCam = (Cam.CFrame.Position - posParte).Magnitude
        if distCam < 0.1 then continue end
        local px     = factorProj / distCam
        local mitadW = (parte.Size.X * px) * 0.55
        local mitadH = (parte.Size.Y * px) * 0.55
        if math.abs(posMouse.X - sp.X) <= mitadW and math.abs(posMouse.Y - sp.Y) <= mitadH then
            return true
        end
    end
    return false
end

-- ─── ESP: bounding box 3D → 8 esquinas → 2D ─────────
--
-- Para cada BasePart calculamos las 8 esquinas del cubo
-- en espacio mundo usando su CFrame y Size, luego
-- proyectamos cada esquina a pantalla con WorldToViewportPoint.
-- Tomamos el min/max de X e Y en píxeles → box perfecto
-- sin importar distancia ni rotación del personaje.

-- Cache de partes por jugador para no llamar GetDescendants cada frame
local cacheParts = {}

local function actualizarCacheParts(jugador)
    if not jugador.Character then return end
    local partes = {}
    for _, v in ipairs(jugador.Character:GetDescendants()) do
        if v:IsA("BasePart") then
            partes[#partes+1] = v
        end
    end
    cacheParts[jugador] = partes
end

-- Box usando solo Head (arriba) y HRP+pies (abajo): O(1) en vez de O(n partes)
-- Preciso porque la altura del personaje es fija
local function calcularBox2D(char)
    local eCab = char:FindFirstChild("Head")
    local eHRP = char:FindFirstChild("HumanoidRootPart")
    if not eCab or not eHRP then return nil end

    -- Punto más alto: encima de la cabeza
    -- Punto más bajo: debajo del HRP (pies)
    local puntoTop  = eCab.Position + Vector3.new(0,  eCab.Size.Y * 0.6, 0)
    local puntoBtm  = eHRP.Position - Vector3.new(0,  3.1, 0)

    local spT, enT = Cam:WorldToViewportPoint(puntoTop)
    local spB, enB = Cam:WorldToViewportPoint(puntoBtm)
    if not enT or not enB or spT.Z <= 0 or spB.Z <= 0 then return nil end

    -- Ancho proporcional a la altura proyectada
    local h = math.abs(spB.Y - spT.Y)
    local w = h * 0.4

    local cx = (spT.X + spB.X) * 0.5
    return cx - w, spT.Y, cx + w, spB.Y
end

local function nuevaLinea(grosor)
    local l = Drawing.new("Line")
    l.Thickness    = grosor
    l.Color        = ESP_COLOR
    l.Visible      = false
    l.Transparency = 1
    return l
end

local function crearESP()
    local d = {
        top    = nuevaLinea(ESP_GROSOR_BOX),
        bottom = nuevaLinea(ESP_GROSOR_BOX),
        left   = nuevaLinea(ESP_GROSOR_BOX),
        right  = nuevaLinea(ESP_GROSOR_BOX),
        skel   = {},
    }
    for i = 1, #CONEXIONES_ESQUELETO do
        d.skel[i] = nuevaLinea(ESP_GROSOR_SKEL)
    end
    return d
end

local function destruirESP(d)
    if not d then return end
    d.top:Remove(); d.bottom:Remove(); d.left:Remove(); d.right:Remove()
    for _, l in ipairs(d.skel) do l:Remove() end
end

local function ocultarESP(d)
    if not d then return end
    d.top.Visible = false; d.bottom.Visible = false
    d.left.Visible = false; d.right.Visible = false
    for _, l in ipairs(d.skel) do l.Visible = false end
end

local function setLinea(l, x1, y1, x2, y2)
    l.From = Vector2.new(x1, y1)
    l.To   = Vector2.new(x2, y2)
    l.Visible = true
end

local function actualizarESP(jugador, d)
    if not d then return end
    local char = jugador.Character
    if not char or not ESP_ACTIVADO then ocultarESP(d); return end

    local eHRP = char:FindFirstChild("HumanoidRootPart")
    if not eHRP then ocultarESP(d); return end

    local miChar = LP.Character
    local miHRP  = miChar and miChar:FindFirstChild("HumanoidRootPart")
    if not miHRP then ocultarESP(d); return end

    if (miHRP.Position - eHRP.Position).Magnitude > ESP_DISTANCIA then
        ocultarESP(d); return
    end

    local minX, minY, maxX, maxY = calcularBox2D(char)
    if not minX then ocultarESP(d); return end

    setLinea(d.top,    minX, minY, maxX, minY)
    setLinea(d.bottom, minX, maxY, maxX, maxY)
    setLinea(d.left,   minX, minY, minX, maxY)
    setLinea(d.right,  maxX, minY, maxX, maxY)

    for i, con in ipairs(CONEXIONES_ESQUELETO) do
        local p1 = char:FindFirstChild(con[1])
        local p2 = char:FindFirstChild(con[2])
        local ln = d.skel[i]
        if p1 and p2 then
            local sp1, en1 = Cam:WorldToViewportPoint(p1.Position)
            local sp2, en2 = Cam:WorldToViewportPoint(p2.Position)
            if en1 and en2 and sp1.Z > 0 and sp2.Z > 0 then
                setLinea(ln, sp1.X, sp1.Y, sp2.X, sp2.Y)
            else
                ln.Visible = false
            end
        else
            ln.Visible = false
        end
    end
end

local function registrar(p)
    if p == LP then return end
    espDatos[p] = crearESP()
    p.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        if not espDatos[p] then espDatos[p] = crearESP() end
        actualizarCacheParts(p)
    end)
    if p.Character then actualizarCacheParts(p) end
end

Players.PlayerAdded:Connect(registrar)
Players.PlayerRemoving:Connect(function(p)
    destruirESP(espDatos[p]); espDatos[p] = nil; cacheParts[p] = nil
end)
for _, p in pairs(Players:GetPlayers()) do registrar(p) end

-- ESP en RenderStepped (sincronizado con render, más suave que Heartbeat)
RunService.RenderStepped:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do
        if p == LP then continue end
        if not espDatos[p] then espDatos[p] = crearESP() end
        actualizarESP(p, espDatos[p])
    end
end)

RunService.Heartbeat:Connect(function()
    if not activado then return end
    local ahora    = tick()
    local posMouse = UserInputService:GetMouseLocation()

    for _, p in pairs(Players:GetPlayers()) do
        if not EsEnemigo(p) or not p.Character then continue end
        local eHRP = p.Character:FindFirstChild("HumanoidRootPart")
        local eHum = p.Character:FindFirstChildOfClass("Humanoid")
        if not eHRP or not eHum or eHum.Health <= 0 then continue end
        if not cursorSobreHitbox(p.Character, posMouse, eHRP) then continue end
        if not tieneLoS(p.Character) then continue end
        if (ahora - ultimoClick) < RETARDO then break end
        if math.random() <= PROBABILIDAD then
            ultimoClick = ahora
            mouse1click()
            local snapP, snapHRP = p, eHRP
            task.spawn(function()
                task.wait(0.02)
                dispararAuto({jugador = snapP, hrp = snapHRP})
            end)
        end
        break
    end
end)

UserInputService.InputBegan:Connect(function(input, procesado)
    if procesado then return end
    if input.KeyCode == Enum.KeyCode.F then
        activado = not activado
        print("[AutoClick]", activado and "ACTIVADO" or "DESACTIVADO")
    end
    if input.KeyCode == Enum.KeyCode.Z then
        ESP_ACTIVADO = not ESP_ACTIVADO
        if not ESP_ACTIVADO then
            for _, d in pairs(espDatos) do ocultarESP(d) end
        end
        print("[ESP]", ESP_ACTIVADO and "ACTIVADO" or "DESACTIVADO")
    end
end)
