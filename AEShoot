-- AeShoot v2 – Versión mejorada y más estable
-- Teclas: F = Toggle Autoshoot    Z = Toggle ESP

-- ===================== CONFIGURACION =====================
local CFG = {
    AUTOSHOOT_ENABLED     = true,           -- Estado inicial
    PROBABILIDAD          = 1.00,           -- 1.0 = 100%
    RETARDO_MINIMO        = 0.00,           -- tiempo mínimo entre disparos auto (seg)
    PREDICCION_MOVIMIENTO = 0.10,           -- predicción para chequeo de cursor
    PREDICCION_DISPARO    = 0.145,          -- predicción para el disparo real
    PODER_KILL            = 5,              -- cuántas veces se envía el remote kill
    DELAY_KILL            = 0.03,           -- delay entre cada kill remote
    ESP_ENABLED           = false,
    ESP_MAX_DIST          = 500,
    ESP_COLOR             = Color3.fromRGB(0, 255, 80),
    ESP_THICKNESS_BOX     = 1.4,
    ESP_THICKNESS_SKELETON= 1.0,
}

-- ===================== SERVICIOS & CACHE =====================
local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")
local Workspace         = game:GetService("Workspace")

local LocalPlayer       = Players.LocalPlayer
local Camera            = Workspace.CurrentCamera

local mouseLocation     --> se actualiza cada frame
local lastShotTime      = 0
local ESP_Objects       = {}   -- [Player] = {box lines, skeleton lines}

-- Conexiones del esqueleto (R6/R15 compatibles)
local SKELETON_CONNECTIONS = {
    {"Head", "UpperTorso"},    {"UpperTorso", "LowerTorso"},
    {"LowerTorso", "LeftUpperLeg"},  {"LowerTorso", "RightUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"}, {"RightUpperLeg", "RightLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},     {"RightLowerLeg", "RightFoot"},
    {"UpperTorso", "LeftUpperArm"},   {"UpperTorso", "RightUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"}, {"RightUpperArm", "RightLowerArm"},
    {"LeftLowerArm", "LeftHand"},     {"RightLowerArm", "RightHand"},
}

print("[AeShoot] Cargado →  F = Autoshoot   |   Z = ESP")

-- ===================== FUNCIONES AUXILIARES =====================

local function isEnemy(player)
    if player == LocalPlayer then return false end
    local char = player.Character
    if not char then return false end

    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local myTeam  = LocalPlayer:GetAttribute("Team")   or "?"
    local hisTeam = player:GetAttribute("Team")        or "?"
    local myGame  = LocalPlayer:GetAttribute("Game")   or "?"
    local hisGame = player:GetAttribute("Game")        or "?"

    return myTeam ~= hisTeam and myGame == hisGame
end


local function hasLineOfSight(targetChar)
    local myChar = LocalPlayer.Character
    if not myChar then return false end

    local myRoot  = myChar:FindFirstChild("HumanoidRootPart") or myChar.PrimaryPart
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local head    = targetChar:FindFirstChild("Head")

    if not myRoot or not targetRoot then return false end

    local filter = {myChar}
    for _, plr in Players:GetPlayers() do
        if plr ~= LocalPlayer and plr.Character then
            table.insert(filter, plr.Character)
        end
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = filter
    rayParams.IgnoreWater = true

    local points = {
        targetRoot.Position,
        targetRoot.Position + Vector3.new(0, 1.2, 0),
        targetRoot.Position + Vector3.new(0, -1.8, 0),
    }
    if head then table.insert(points, head.Position) end

    local origins = {myRoot.Position, Camera.CFrame.Position}

    for _, origin in origins do
        for _, targetPos in points do
            local direction = targetPos - origin
            local result = Workspace:Raycast(origin, direction, rayParams)
            if not result then return true end
        end
    end

    return false
end


local function getWeapon()
    local char = LocalPlayer.Character
    if not char then return nil end

    for _, tool in char:GetChildren() do
        if tool:IsA("Tool") then
            if tool:FindFirstChild("fire") and
               tool:FindFirstChild("showBeam") and
               tool:FindFirstChild("kill") then
                return tool
            end
        end
    end
    return nil
end


local function fireAt(targetData)
    local char = LocalPlayer.Character
    if not char then return end

    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local weapon   = getWeapon()

    if not rootPart or not weapon then return end

    local fire      = weapon:FindFirstChild("fire")
    local showBeam  = weapon:FindFirstChild("showBeam")
    local kill      = weapon:FindFirstChild("kill")
    local handle    = weapon:FindFirstChild("Handle")

    if not (fire and showBeam and kill and handle) then return end

    local predictedPos = targetData.root.Position + (targetData.root.AssemblyLinearVelocity * CFG.PREDICCION_DISPARO)
    local lookDir = (predictedPos - rootPart.Position).Unit

    fire:FireServer()
    showBeam:FireServer(predictedPos, rootPart.Position, handle)

    task.defer(function()
        for i = 1, CFG.PODER_KILL do
            kill:FireServer(targetData.player, lookDir)
            if i < CFG.PODER_KILL then
                task.wait(CFG.DELAY_KILL)
            end
        end
    end)
end


local function isCursorOverHitbox(char, mousePos, rootPart)
    local fovRad = math.rad(Camera.FieldOfView)
    local projFactor = Camera.ViewportSize.Y / (2 * math.tan(fovRad / 2))

    for _, part in char:GetDescendants() do
        if not part:IsA("BasePart") then continue end

        local predPos = part.Position + (rootPart.AssemblyLinearVelocity * CFG.PREDICCION_MOVIMIENTO)
        local screenPos, onScreen = Camera:WorldToViewportPoint(predPos)

        if not onScreen or screenPos.Z <= 0 then continue end

        local distToCam = (Camera.CFrame.Position - predPos).Magnitude
        if distToCam < 0.2 then continue end

        local scale = projFactor / distToCam
        local halfW = part.Size.X * scale * 0.6
        local halfH = part.Size.Y * scale * 0.6

        if math.abs(mousePos.X - screenPos.X) <= halfW and
           math.abs(mousePos.Y - screenPos.Y) <= halfH then
            return true
        end
    end
    return false
end


-- ===================== ESP =====================

local function newLine(thickness)
    local line = Drawing.new("Line")
    line.Thickness   = thickness
    line.Color       = CFG.ESP_COLOR
    line.Transparency= 1
    line.Visible     = false
    return line
end

local function createESPContainer()
    local container = {
        box = {
            top    = newLine(CFG.ESP_THICKNESS_BOX),
            bottom = newLine(CFG.ESP_THICKNESS_BOX),
            left   = newLine(CFG.ESP_THICKNESS_BOX),
            right  = newLine(CFG.ESP_THICKNESS_BOX),
        },
        skeleton = {}
    }

    for i = 1, #SKELETON_CONNECTIONS do
        container.skeleton[i] = newLine(CFG.ESP_THICKNESS_SKELETON)
    end

    return container
end

local function destroyESP(container)
    if not container then return end
    for _, line in pairs(container.box) do line:Remove() end
    for _, line in ipairs(container.skeleton) do line:Remove() end
end

local function hideESP(container)
    if not container then return end
    for _, line in pairs(container.box) do line.Visible = false end
    for _, line in ipairs(container.skeleton) do line.Visible = false end
end

local function updateBoxESP(char, container)
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local anyVisible = false

    for _, part in char:GetDescendants() do
        if not part:IsA("BasePart") then continue end
        local cf, size = part.CFrame, part.Size
        for _, offset in {
            Vector3.new( size.X, size.Y, size.Z),
            Vector3.new(-size.X, size.Y, size.Z),
            Vector3.new( size.X,-size.Y, size.Z),
            Vector3.new(-size.X,-size.Y, size.Z),
            Vector3.new( size.X, size.Y,-size.Z),
            Vector3.new(-size.X, size.Y,-size.Z),
            Vector3.new( size.X,-size.Y,-size.Z),
            Vector3.new(-size.X,-size.Y,-size.Z),
        } do
            local world = cf.Position + cf:VectorToWorldSpace(offset * 0.5)
            local sp, vis = Camera:WorldToViewportPoint(world)
            if not vis or sp.Z <= 0 then continue end
            minX = math.min(minX, sp.X)
            minY = math.min(minY, sp.Y)
            maxX = math.max(maxX, sp.X)
            maxY = math.max(maxY, sp.Y)
            anyVisible = true
        end
    end

    if not anyVisible then
        hideESP(container)
        return
    end

    local b = container.box
    b.top.From, b.top.To     = Vector2.new(minX,minY), Vector2.new(maxX,minY)
    b.bottom.From, b.bottom.To = Vector2.new(minX,maxY), Vector2.new(maxX,maxY)
    b.left.From, b.left.To   = Vector2.new(minX,minY), Vector2.new(minX,maxY)
    b.right.From, b.right.To = Vector2.new(maxX,minY), Vector2.new(maxX,maxY)

    for _, line in pairs(b) do line.Visible = true end
end

local function updateSkeleton(char, container)
    for i, pair in ipairs(SKELETON_CONNECTIONS) do
        local p1 = char:FindFirstChild(pair[1])
        local p2 = char:FindFirstChild(pair[2])
        local line = container.skeleton[i]

        if p1 and p2 then
            local sp1, v1 = Camera:WorldToViewportPoint(p1.Position)
            local sp2, v2 = Camera:WorldToViewportPoint(p2.Position)
            if v1 and v2 and sp1.Z > 0 and sp2.Z > 0 then
                line.From = Vector2.new(sp1.X, sp1.Y)
                line.To   = Vector2.new(sp2.X, sp2.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end

local function updateESP(player, container)
    if not CFG.ESP_ENABLED then
        hideESP(container)
        return
    end

    local char = player.Character
    if not char then
        hideESP(container)
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then
        hideESP(container)
        return
    end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or (myRoot.Position - root.Position).Magnitude > CFG.ESP_MAX_DIST then
        hideESP(container)
        return
    end

    updateBoxESP(char, container)
    updateSkeleton(char, container)
end

-- ===================== INICIALIZACION ESP =====================

local function setupESPForPlayer(player)
    if player == LocalPlayer then return end
    if ESP_Objects[player] then return end

    ESP_Objects[player] = createESPContainer()

    -- Re-crear si el personaje reaparece
    player.CharacterAdded:Connect(function()
        task.wait(0.2)
        if not ESP_Objects[player] then
            ESP_Objects[player] = createESPContainer()
        end
    end)
end

for _, player in Players:GetPlayers() do
    setupESPForPlayer(player)
end

Players.PlayerAdded:Connect(setupESPForPlayer)

Players.PlayerRemoving:Connect(function(player)
    if ESP_Objects[player] then
        destroyESP(ESP_Objects[player])
        ESP_Objects[player] = nil
    end
end)

-- ===================== LOOP PRINCIPAL =====================

RunService.Heartbeat:Connect(function()
    mouseLocation = UserInputService:GetMouseLocation()

    -- Actualizar ESP
    for player, container in pairs(ESP_Objects) do
        updateESP(player, container)
    end

    -- Autoshoot
    if not CFG.AUTOSHOOT_ENABLED then return end

    local now = tick()
    if now - lastShotTime < CFG.RETARDO_MINIMO then return end

    for _, player in Players:GetPlayers() do
        if not isEnemy(player) then continue end
        local char = player.Character
        if not char then continue end

        local root = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildWhichIsA("Humanoid")
        if not root or not hum or hum.Health <= 0 then continue end

        if not isCursorOverHitbox(char, mouseLocation, root) then continue end
        if not hasLineOfSight(char) then continue end

        -- ¡Disparamos!
        lastShotTime = now

        if math.random() > CFG.PROBABILIDAD then continue end

        -- mouse1click() → simula clic (puede no funcionar en todos los juegos)
        mouse1click()

        -- Disparo real con predicción
        task.spawn(function()
            task.wait(0.015)  -- pequeño retraso para que el juego registre mejor el clic
            fireAt({player = player, root = root})
        end)

        break   -- solo un objetivo por frame
    end
end)


-- ===================== TECLAS =====================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.F then
        CFG.AUTOSHOOT_ENABLED = not CFG.AUTOSHOOT_ENABLED
        print("[AeShoot] Autoshoot:", CFG.AUTOSHOOT_ENABLED and "ON" or "OFF")
    end

    if input.KeyCode == Enum.KeyCode.Z then
        CFG.ESP_ENABLED = not CFG.ESP_ENABLED
        print("[ESP] ", CFG.ESP_ENABLED and "ON" or "OFF")
        if not CFG.ESP_ENABLED then
            for _, cont in pairs(ESP_Objects) do
                hideESP(cont)
            end
        end
    end
end)
